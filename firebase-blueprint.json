{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and security settings including Biometric lock preference and mobile/Google registration info.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "User full name."
        },
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Verified mobile number for IPO alerts and allotment."
        },
        "authProvider": {
          "type": "string",
          "description": "Sign-in method label (Google or Mobile+Google)."
        },
        "biometricEnabled": {
          "type": "boolean",
          "description": "Whether BiometricPrompt app lock is enabled."
        },
        "priceAlertsEnabled": {
          "type": "boolean",
          "description": "Whether GMP surge & subscription alerts are enabled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "biometricEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "PanProfile": {
      "title": "PanProfile",
      "description": "Family PAN & Demat account stored in the user's encrypted cloud vault for 1-click multi-lot IPO applications and allotment checks.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "holderName": {
          "type": "string",
          "description": "Account holder full name as per PAN."
        },
        "panNumber": {
          "type": "string",
          "description": "10-character uppercase Indian PAN number."
        },
        "dematId": {
          "type": "string",
          "description": "16-digit CDSL/NSDL BO ID or DP Client ID."
        },
        "upiId": {
          "type": "string",
          "description": "Linked UPI ID for ASBA mandate."
        },
        "category": {
          "type": "string",
          "description": "Default investor category (Retail, sHNI, bHNI)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "holderName",
        "panNumber",
        "dematId",
        "upiId",
        "category",
        "createdAt",
        "updatedAt"
      ]
    },
    "IpoApplication": {
      "title": "IpoApplication",
      "description": "Tracked IPO bid/application submitted or logged by the user for allotment & profit tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "ipoId": {
          "type": "string",
          "description": "InvestorGain IPO ID."
        },
        "ipoName": {
          "type": "string",
          "description": "Company short name."
        },
        "panHolderName": {
          "type": "string",
          "description": "Applicant name from PAN Vault."
        },
        "panNumber": {
          "type": "string",
          "description": "10-char PAN number used for bid."
        },
        "category": {
          "type": "string",
          "description": "Investor category (Retail, sHNI, bHNI)."
        },
        "lotsApplied": {
          "type": "integer",
          "description": "Number of lots applied."
        },
        "sharesApplied": {
          "type": "integer",
          "description": "Total shares applied."
        },
        "bidPrice": {
          "type": "integer",
          "description": "Cut-off bid price per share in INR."
        },
        "totalAmount": {
          "type": "integer",
          "description": "Total blocked ASBA mandate amount in INR."
        },
        "upiId": {
          "type": "string",
          "description": "UPI ID used for mandate."
        },
        "status": {
          "type": "string",
          "description": "Application status (Mandate Pending, Applied, Allotted, Not Allotted)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "ipoId",
        "ipoName",
        "panHolderName",
        "panNumber",
        "category",
        "lotsApplied",
        "sharesApplied",
        "bidPrice",
        "totalAmount",
        "upiId",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "Bookmarked InvestorGain IPO for quick GMP and subscription tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "ipoId": {
          "type": "string",
          "description": "InvestorGain IPO ID."
        },
        "ipoName": {
          "type": "string",
          "description": "Company short name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "ipoId",
        "ipoName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and biometric security preferences."
    },
    "/users/{userId}/pan_profiles/{panId}": {
      "schema": "PanProfile",
      "description": "Encrypted/isolated family PAN and Demat accounts for the user."
    },
    "/users/{userId}/applications/{appId}": {
      "schema": "IpoApplication",
      "description": "User's tracked IPO bids and allotment status."
    },
    "/users/{userId}/watchlist/{ipoId}": {
      "schema": "WatchlistItem",
      "description": "User's watched InvestorGain IPOs."
    }
  }
}
